generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Площадка и люди ─────────────

model Property {
  id                String     @id @default(cuid())
  slug              String     @unique
  name              String
  tagline           String?
  description       String?
  address           String?
  phone             String?
  timezone          String     @default("Europe/Minsk")
  // Режимы контроля: что гость видит сам, а что узнаёт только от администратора
  showAvailability  Boolean    @default(false)
  priceMode         PriceMode  @default(from)
  prepaymentPercent Int        @default(30)
  callbackMinutes   Int        @default(60)
  checkInTime       String     @default("15:00")
  checkOutTime      String     @default("12:00")
  telegramChatId    String?
  /// Как перевести предоплату: карта, ЕРИП, счёт — показывается в КП
  paymentDetails    String?
  createdAt         DateTime   @default(now())
  users             User[]
  units             Unit[]
  extras            Extra[]
  leads             Lead[]
}

model User {
  id           String      @id @default(cuid())
  propertyId   String
  email        String      @unique
  name         String
  passwordHash String
  role         Role        @default(admin)
  createdAt    DateTime    @default(now())
  property     Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  events       LeadEvent[]
}

// ───────────── Что сдаётся и почём ─────────────

model Unit {
  id            String      @id @default(cuid())
  propertyId    String
  slug          String
  name          String
  kind          UnitKind
  description   String?
  capacity      Int
  baseGuests    Int
  photo         String?
  sortOrder     Int         @default(0)
  active        Boolean     @default(true)
  // Секрет для iCal-ленты: Google Календарь, Куфар, Реалт подписываются на неё
  icalToken     String      @unique @default(cuid())
  property      Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rates         Rate[]
  leads         Lead[]
  blocks        Block[]
  calendarFeeds CalendarFeed[]

  @@unique([propertyId, slug])
}

/// Цена за ночь. Для каждой ночи выбирается подходящее правило с наибольшим priority.
model Rate {
  id              String    @id @default(cuid())
  unitId          String
  name            String
  startDate       DateTime? @db.Date
  endDate         DateTime? @db.Date
  /// 0 = воскресенье … 6 = суббота; пустой массив = любой день
  weekdays        Int[]
  pricePerNight   Int
  extraGuestPrice Int       @default(0)
  priority        Int       @default(0)
  unit            Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

model Extra {
  id          String         @id @default(cuid())
  propertyId  String
  name        String
  description String?
  priceType   ExtraPriceType
  price       Int
  active      Boolean        @default(true)
  sortOrder   Int            @default(0)
  property    Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

// ───────────── Заявка → звонок → КП → предоплата ─────────────

model Lead {
  id            String       @id @default(cuid())
  propertyId    String
  unitId        String?
  status        LeadStatus   @default(new)
  source        LeadSource   @default(site)
  occasion      String?
  checkIn       DateTime     @db.Date
  checkOut      DateTime     @db.Date
  guests        Int
  name          String
  phone         String
  contactVia    ContactVia   @default(call)
  comment       String?
  /// Расчёт на момент заявки: { total, nights[], extras[] }
  quote         Json?
  estimate      Int?
  extraIds      String[]
  createdAt     DateTime     @default(now())
  contactedAt   DateTime?
  property      Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit          Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  events        LeadEvent[]
  proposal      Proposal?

  @@index([propertyId, status])
  @@index([unitId, checkIn])
}

model LeadEvent {
  id        String        @id @default(cuid())
  leadId    String
  userId    String?
  type      LeadEventType
  text      String?
  createdAt DateTime      @default(now())
  lead      Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

/// Живое коммерческое предложение по ссылке
model Proposal {
  id                String         @id @default(cuid())
  leadId            String         @unique
  token             String         @unique @default(cuid())
  /// [{ id, title, note, price, extraIds }]
  options           Json
  chosenOptionId    String?
  message           String?
  prepaymentAmount  Int
  splitEnabled      Boolean        @default(true)
  views             Int            @default(0)
  lastViewedAt      DateTime?
  acceptedAt        DateTime?
  createdAt         DateTime       @default(now())
  lead              Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contributions     Contribution[]
}

/// «Скинуться компанией»: каждый участник отмечает свою долю, администратор подтверждает
model Contribution {
  id          String             @id @default(cuid())
  proposalId  String
  name        String
  amount      Int
  status      ContributionStatus @default(pledged)
  createdAt   DateTime           @default(now())
  confirmedAt DateTime?
  proposal    Proposal           @relation(fields: [proposalId], references: [id], onDelete: Cascade)
}

// ───────────── Занятость из других мест ─────────────

model Block {
  id         String        @id @default(cuid())
  unitId     String
  start      DateTime      @db.Date
  end        DateTime      @db.Date
  reason     String?
  feedId     String?
  externalId String?
  unit       Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  feed       CalendarFeed? @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@unique([feedId, externalId])
  @@index([unitId, start])
}

/// Внешний календарь, из которого подтягиваем занятость (Google, Куфар, Реалт…)
model CalendarFeed {
  id         String    @id @default(cuid())
  unitId     String
  label      String
  url        String
  lastSyncAt DateTime?
  lastError  String?
  unit       Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  blocks     Block[]
}

enum Role {
  owner
  admin
  staff
}

enum PriceMode {
  exact
  from
  hidden
}

enum UnitKind {
  house
  room
  venue
  whole
}

enum ExtraPriceType {
  per_stay
  per_night
  per_person
  per_hour
}

enum LeadStatus {
  new
  contacted
  proposal
  booked
  done
  lost
}

enum LeadSource {
  site
  phone
  messenger
  other
}

enum ContactVia {
  call
  telegram
  viber
}

enum LeadEventType {
  created
  status
  note
  call
  proposal_sent
  proposal_viewed
  proposal_accepted
  contribution
}

enum ContributionStatus {
  pledged
  marked_paid
  confirmed
}
