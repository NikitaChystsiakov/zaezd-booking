generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Усадьба и люди ─────────────

model Property {
  id                String     @id @default(cuid())
  slug              String     @unique
  name              String
  /// Короткая подпись под названием: «Конная усадьба»
  kind              String?
  tagline           String?
  description       String?
  address           String?
  phone             String?
  phone2            String?
  email             String?
  instagram         String?
  heroPhoto         String?
  /// Оформление страницы бронирования: forest — тёмная хвоя (Буцевичи), linen — светлое
  theme             String     @default("linen")
  timezone          String     @default("Europe/Minsk")
  checkInTime       String     @default("15:00")
  checkOutTime      String     @default("12:00")
  /// Условия бронирования, по одному пункту на строку
  bookingTerms      String?
  /// Праздничные даты 'YYYY-MM-DD' — для тарифов «в праздники»
  holidays          String[]
  // Что гость видит сам, а что узнаёт только от администратора
  showAvailability  Boolean    @default(true)
  priceMode         PriceMode  @default(exact)
  depositPercent    Int        @default(30)
  callbackMinutes   Int        @default(60)
  paymentDetails    String?
  telegramChatId    String?
  /// КП и «скинуться компанией» — выключены, пока не понадобятся
  proposalsEnabled  Boolean    @default(false)
  createdAt         DateTime   @default(now())
  users             User[]
  units             Unit[]
  extras            Extra[]
  leads             Lead[]
}

model User {
  id           String      @id @default(cuid())
  propertyId   String
  email        String      @unique
  name         String
  passwordHash String
  role         Role        @default(admin)
  createdAt    DateTime    @default(now())
  property     Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  events       LeadEvent[]
}

// ───────────── Что сдаётся и почём ─────────────

model Unit {
  id                  String         @id @default(cuid())
  propertyId          String
  slug                String
  name                String
  kind                UnitKind       @default(house)
  summary             String?
  description         String?
  /// Максимум гостей с ночлегом
  capacity            Int
  photos              String[]
  amenities           String[]
  /// Скидка за долгое проживание: начиная с ночи номер longStayFromNight
  longStayFromNight   Int?
  longStayPercent     Int            @default(0)
  sortOrder           Int            @default(0)
  active              Boolean        @default(true)
  /// Секрет для iCal-ленты: Google Календарь, Куфар, Реалт подписываются на неё
  icalToken           String         @unique @default(cuid())
  property            Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rates               Rate[]
  leads               Lead[]
  blocks              Block[]
  calendarFeeds       CalendarFeed[]

  @@unique([propertyId, slug])
}

/// Тариф за ночь. Для каждой ночи берутся подходящие тарифы с наибольшим приоритетом,
/// из них — самый выгодный для гостя.
model Rate {
  id                String    @id @default(cuid())
  unitId            String
  name              String
  /// 0 = воскресенье … 6 = суббота; пустой массив = любой день
  weekdays          Int[]
  /// Только в праздничные даты усадьбы
  holidaysOnly      Boolean   @default(false)
  startDate         DateTime? @db.Date
  endDate           DateTime? @db.Date
  minGuests         Int       @default(1)
  maxGuests         Int?
  /// Сколько гостей входит в цену; за остальных — extraGuestPrice
  includedGuests    Int
  pricePerNight     Int
  extraGuestPrice   Int       @default(0)
  /// Тариф доступен, только если до заезда не больше N дней (например, «малые компании — за 2 недели»)
  bookableWithinDays Int?
  priority          Int       @default(0)
  sortOrder         Int       @default(0)
  unit              Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

model Extra {
  id          String         @id @default(cuid())
  propertyId  String
  name        String
  description String?
  priceType   ExtraPriceType
  price       Int
  /// Подпись к количеству: «сеанс», «час», «чел.»
  unitLabel   String?
  /// 1 — галочка, больше — счётчик
  maxQty      Int            @default(1)
  group       String?
  active      Boolean        @default(true)
  sortOrder   Int            @default(0)
  property    Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

// ───────────── Заявки ─────────────

model Lead {
  id            String       @id @default(cuid())
  propertyId    String
  unitId        String?
  status        LeadStatus   @default(new)
  source        LeadSource   @default(site)
  occasion      String?
  checkIn       DateTime     @db.Date
  checkOut      DateTime     @db.Date
  guests        Int
  children      Int          @default(0)
  name          String
  phone         String
  contactVia    ContactVia   @default(call)
  comment       String?
  /// Выбранные услуги: [{ id, qty }]
  extras        Json         @default("[]")
  /// Расчёт на момент заявки
  quote         Json?
  estimate      Int?
  createdAt     DateTime     @default(now())
  contactedAt   DateTime?
  property      Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit          Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  events        LeadEvent[]
  proposal      Proposal?

  @@index([propertyId, status])
  @@index([unitId, checkIn])
}

model LeadEvent {
  id        String        @id @default(cuid())
  leadId    String
  userId    String?
  type      LeadEventType
  text      String?
  createdAt DateTime      @default(now())
  lead      Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

/// Живое коммерческое предложение (выключено флагом proposalsEnabled)
model Proposal {
  id                String         @id @default(cuid())
  leadId            String         @unique
  token             String         @unique @default(cuid())
  options           Json
  chosenOptionId    String?
  message           String?
  prepaymentAmount  Int
  splitEnabled      Boolean        @default(true)
  views             Int            @default(0)
  lastViewedAt      DateTime?
  acceptedAt        DateTime?
  createdAt         DateTime       @default(now())
  lead              Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contributions     Contribution[]
}

model Contribution {
  id          String             @id @default(cuid())
  proposalId  String
  name        String
  amount      Int
  status      ContributionStatus @default(pledged)
  createdAt   DateTime           @default(now())
  confirmedAt DateTime?
  proposal    Proposal           @relation(fields: [proposalId], references: [id], onDelete: Cascade)
}

// ───────────── Занятость из других мест ─────────────

model Block {
  id         String        @id @default(cuid())
  unitId     String
  start      DateTime      @db.Date
  end        DateTime      @db.Date
  reason     String?
  feedId     String?
  externalId String?
  unit       Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  feed       CalendarFeed? @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@unique([feedId, externalId])
  @@index([unitId, start])
}

model CalendarFeed {
  id         String    @id @default(cuid())
  unitId     String
  label      String
  url        String
  lastSyncAt DateTime?
  lastError  String?
  unit       Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  blocks     Block[]
}

enum Role {
  owner
  admin
  staff
}

enum PriceMode {
  exact
  from
  hidden
}

enum UnitKind {
  house
  room
  venue
  whole
}

enum ExtraPriceType {
  per_stay
  per_night
  per_person
  per_item
}

enum LeadStatus {
  new
  contacted
  proposal
  booked
  done
  lost
}

enum LeadSource {
  site
  phone
  messenger
  other
}

enum ContactVia {
  call
  telegram
  viber
}

enum LeadEventType {
  created
  status
  note
  call
  proposal_sent
  proposal_viewed
  proposal_accepted
  contribution
}

enum ContributionStatus {
  pledged
  marked_paid
  confirmed
}
